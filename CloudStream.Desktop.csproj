<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- mpv integration for WPF playback.  When restoring the project on Windows this
         package will pull in the native libmpv binaries.  -->
    <PackageReference Include="Mpv.NET.WPF" Version="1.1.6" />
    <!-- SQLite provider for data persistence.  -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>
</Project>