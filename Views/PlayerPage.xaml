<Page x:Class="CloudStream.Desktop.Views.PlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mpv="clr-namespace:Mpv.Wpf;assembly=Mpv.Wpf"
      Title="Player">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Video playback surface -->
        <mpv:VideoView x:Name="VideoView" Grid.Row="0" />

        <!-- Controls bar -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Background="#66000000" Padding="10">
            <Button x:Name="PlayPauseButton" Content="Play" Width="60" Click="PlayPauseButton_Click" />
            <Button x:Name="StopButton" Content="Stop" Width="60" Margin="10,0,0,0" Click="StopButton_Click" />
            <ComboBox x:Name="StreamSelector" Width="120" Margin="10,0,0,0" SelectionChanged="StreamSelector_SelectionChanged" />
        </StackPanel>
    </Grid>
</Page>