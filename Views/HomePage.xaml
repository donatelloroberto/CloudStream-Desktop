<Page x:Class="CloudStream.Desktop.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Home">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Continue Watching" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" />
            <ListBox x:Name="ContinueWatchingList" DisplayMemberPath="Item.Title" Height="150" SelectionChanged="ContinueWatchingList_SelectionChanged" />

            <TextBlock Text="Bookmarks" FontSize="18" FontWeight="Bold" Margin="0,20,0,10" />
            <ListBox x:Name="BookmarksList" DisplayMemberPath="Title" Height="150" SelectionChanged="BookmarksList_SelectionChanged" />
        </StackPanel>
    </ScrollViewer>
</Page>