<Page x:Class="CloudStream.Desktop.Views.SearchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Search">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="QueryBox" Width="300" Margin="0,0,10,0" />
            <Button Content="Search" Width="80" Click="SearchButton_Click" />
        </StackPanel>
        <ListBox x:Name="ResultsList" Margin="0,20,0,0" DisplayMemberPath="Title" SelectionChanged="ResultsList_SelectionChanged" />
    </StackPanel>
</Page>