<Window x:Class="CloudStream.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CloudStream Desktop" Height="600" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Navigation bar -->
        <DockPanel Background="#FF1E1E1E" Grid.Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Home" Margin="5" Padding="10,5"
                        Click="HomeButton_Click" />
                <Button Content="Search" Margin="5" Padding="10,5"
                        Click="SearchButton_Click" />
                <Button Content="Extensions" Margin="5" Padding="10,5"
                        Click="ExtensionsButton_Click" />
                <Button Content="Settings" Margin="5" Padding="10,5"
                        Click="SettingsButton_Click" />
            </StackPanel>
        </DockPanel>

        <!-- Main content frame -->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" />
    </Grid>
</Window>